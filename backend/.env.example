# Copy to .env and adjust as needed
PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional AI provider (leave unset to use the built-in demo analysis).
# When set, AI_PROVIDER must be "openai-compatible" and AI_API_URL/AI_API_KEY
# must point at a real chat-completions endpoint you control.
